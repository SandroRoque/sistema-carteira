# Directory containing the PDF files to process.
NOTAS_DIR=/path/to/notas

# PostgreSQL connection (docker compose up -d starts one on port 5433).
DATABASE_URL=postgresql+psycopg://carteira:carteira@localhost:5433/carteira

# Command-line tools: which account / investidor to act on.
# Optional when the database has exactly one of each.
# CARTEIRA_USUARIO_EMAIL=voce@exemplo.com
# CARTEIRA_INVESTIDOR_ID=1

# Secret for pseudonymizing CPFs (HMAC). Required. Losing or changing it makes
# new uploads stop matching existing portfolios. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CPF_HMAC_KEY=

# Session cookie only over HTTPS (default true). Use false for local http.
# COOKIE_SECURE=false

# Anyone may create an account (default true). Production keeps it false
# until password reset exists; create accounts with admin.py.
# CADASTRO_ABERTO=false

# The web app runs the document import worker in-process (default true).
# CARTEIRA_WORKER=false

# With more than one machine, each LISTENs for uploads received by the others
# (default false: the open connection keeps a serverless Postgres awake).
# CARTEIRA_ESCUTAR_UPLOADS=true
